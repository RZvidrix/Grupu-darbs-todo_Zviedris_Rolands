<!DOCTYPE html>
<html>
<head>
<title>Todo V3</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body onload="loadData()">

<div class="container-sm mt-4">
<div class="card" style="width:22rem;">
<img src="https://media.istockphoto.com/id/157030584/vector/thumb-up-emoticon.jpg?s=612x612&w=0&k=20&c=GGl4NM_6_BzvJxLSl7uCDF4Vlo_zHGZVmmqOBIewgKg=" class="card-img-top">

<div class="card-body">
<h3>Mani darbi</h3>

<div class="btn-group mb-2">
<button class="btn btn-outline-secondary" onclick="filterTasks('all')">Visi</button>
<button class="btn btn-outline-secondary" onclick="filterTasks('active')">Aktivie</button>
<button class="btn btn-outline-secondary" onclick="filterTasks('done')">Pabeigtie</button>
</div>

<input type="text" id="search" class="form-control mb-2" placeholder="Meklet..." onkeyup="searchTasks()">

<select id="priority" class="form-select mb-2">
<option value="high">Svarigi</option>
<option value="medium">Videtji</option>
<option value="low">Zema prioritate</option>
</select>

<div class="input-group mb-3">
<input type="text" class="form-control" id="info">
<button class="btn btn-outline-primary" onclick="add()">Pievienot</button>
</div>

<ul id="task-list" class="list-group"></ul>

<div class="mt-2">
<span id="stats"></span>
<button class="btn btn-sm btn-outline-danger float-end" onclick="clearDone()">Notirit pabeigtos</button>
</div>

</div>
</div>
</div>

<script>

function add(text="",done=false,priority=null){

const input=document.getElementById("info")
const p=priority||document.getElementById("priority").value

const li=document.createElement("li")
li.className="list-group-item d-flex align-items-center"

const cb=document.createElement("input")
cb.type="checkbox"
cb.className="form-check-input me-2"
cb.checked=done

const span=document.createElement("span")
span.textContent=text||input.value
if(done) span.classList.add("text-decoration-line-through")

cb.onclick=function(){
span.classList.toggle("text-decoration-line-through")
saveData()
updateStats()
}

const badge=document.createElement("span")
badge.classList.add("badge","ms-2")

if(p=="high"){badge.classList.add("bg-danger");badge.textContent="Svarigi"}
else if(p=="medium"){badge.classList.add("bg-warning","text-dark");badge.textContent="Videtji"}
else{badge.classList.add("bg-success");badge.textContent="Zema"}

const edit=document.createElement("button")
edit.textContent="Labot"
edit.className="btn btn-outline-info btn-sm ms-auto me-1"
edit.onclick=function(){
let t=prompt("Jauns teksts",span.textContent)
if(t){span.textContent=t;saveData()}
}

const del=document.createElement("button")
del.textContent="Dzest"
del.className="btn btn-danger btn-sm"
del.onclick=function(){li.remove();saveData();updateStats()}

li.append(cb,span,badge,edit,del)

document.getElementById("task-list").appendChild(li)

input.value=""
saveData()
updateStats()
}

function saveData(){

const items=[]

document.querySelectorAll("#task-list li").forEach(li=>{
const text=li.querySelector("span").textContent
const done=li.querySelector("input").checked
const badge=li.querySelector(".badge").textContent

let p="low"
if(badge=="Svarigi")p="high"
else if(badge=="Videtji")p="medium"

items.push({text,done,priority:p})
})

localStorage.setItem("tasks",JSON.stringify(items))
}

function loadData(){
const data=JSON.parse(localStorage.getItem("tasks")||"[]")
data.forEach(i=>add(i.text,i.done,i.priority))
updateStats()
}

function filterTasks(type){

document.querySelectorAll("#task-list li").forEach(li=>{
const done=li.querySelector("input").checked

if(type=="all") li.style.display=""
else if(type=="active") li.style.display=done?"none":""
else li.style.display=done?"":"none"

})
}

function searchTasks(){

const q=document.getElementById("search").value.toLowerCase()

document.querySelectorAll("#task-list li").forEach(li=>{
const text=li.querySelector("span").textContent.toLowerCase()
li.style.display=text.includes(q)?"":"none"
})
}

function clearDone(){

document.querySelectorAll("#task-list li").forEach(li=>{
if(li.querySelector("input").checked) li.remove()
})

saveData()
updateStats()
}

function updateStats(){

let left=0
document.querySelectorAll("#task-list li").forEach(li=>{
if(!li.querySelector("input").checked) left++
})

document.getElementById("stats").textContent="Atlikusi "+left+" darbi"
}

</script>

</body>
</html>
