<!DOCTYPE html>
<html>
<head>
    <title>Todo V2</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body onload="loadData()">
<div class="container-sm mt-4">
    <div class="card" style="width: 22rem;">
        <img src="https://media.istockphoto.com/id/157030584/vector/thumb-up-emoticon.jpg?s=612x612&w=0&k=20&c=GGl4NM_6_BzvJxLSl7uCDF4Vlo_zHGZVmmqOBIewgKg=" class="card-img-top">

        <div class="card-body">
            <h3 class="card-title">Mani darbi</h3>

            <!-- PRIORITATES IZVELNE -->
            <select id="priority" class="form-select mb-2">
                <option value="high">Svarigi</option>
                <option value="medium">Videtji</option>
                <option value="low">Zema prioritate</option>
            </select>

            <!-- Ievades lauks -->
            <div class="input-group mb-3">
                <input type="text" class="form-control" id="info">
                <button class="btn btn-outline-primary" onclick="add()">Pievienot</button>
            </div>

            <ul id="task-list" class="list-group"></ul>
        </div>
    </div>
</div>

<script>

// Pievieno uzdevumu
function add(text = "", done = false, priority = null) {
    const input = document.getElementById("info");
    const selectedPriority = priority || document.getElementById("priority").value;

    const li = document.createElement("li");
    li.className = "list-group-item d-flex align-items-center";

    // Checkbox
    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.classList.add("form-check-input", "me-2");
    checkbox.checked = done;

    // Teksts
    const span = document.createElement("span");
    span.textContent = text || input.value;

    if (done) span.classList.add("text-decoration-line-through");

    checkbox.onclick = function () {
        span.classList.toggle("text-decoration-line-through");
        saveData();
    };

    // Prioritates krasa
    const badge = document.createElement("span");
    badge.classList.add("badge", "ms-2");

    if (selectedPriority === "high") {
        badge.classList.add("bg-danger");
        badge.textContent = "Svarigi";
    } else if (selectedPriority === "medium") {
        badge.classList.add("bg-warning", "text-dark");
        badge.textContent = "Videtji";
    } else {
        badge.classList.add("bg-success");
        badge.textContent = "Zema";
    }

    // Delete poga
    const del = document.createElement("button");
    del.textContent = "Dzest";
    del.classList.add("btn", "btn-danger", "ms-auto");
    del.onclick = function () {
        li.remove();
        saveData();
    };

    li.appendChild(checkbox);
    li.appendChild(span);
    li.appendChild(badge);
    li.appendChild(del);

    document.getElementById("task-list").appendChild(li);
    input.value = "";

    saveData();
}

// Saglaba localStorage
function saveData() {
    const items = [];

    document.querySelectorAll("#task-list li").forEach(li => {
        const text = li.querySelector("span").textContent;
        const done = li.querySelector("input").checked;
        const badge = li.querySelector(".badge").textContent;

        let priority = "low";
        if (badge === "Svarigi") priority = "high";
        else if (badge === "Videtji") priority = "medium";

        items.push({ text, done, priority });
    });

    localStorage.setItem("tasks", JSON.stringify(items));
}

// Ielade localStorage
function loadData() {
    const data = JSON.parse(localStorage.getItem("tasks") || "[]");
    data.forEach(item => add(item.text, item.done, item.priority));
}

</script>
</body>
</html>
